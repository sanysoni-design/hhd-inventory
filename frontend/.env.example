# Browser-safe Supabase project URL and publishable key only.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_PUBLISHABLE_KEY

# Do not add Supabase sb_secret keys, service_role keys, HR sync keys, or passwords here.
# VITE_API_URL remains the existing legacy Apps Script URL for the original application route.
